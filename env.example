# Google Maps API key for route generation
GOOGLE_MAPS_API_KEY=your_api_key_here

# Server configuration
HOST=0.0.0.0
PORT=5000
DEBUG=false
APP_ENV=development
REQUIRE_MAPS_API_KEY=false
BOOTSTRAP_SIMULATION=true
# Set false in production to skip Google Directions API during route generation
USE_MAPS_FOR_ROUTES=true
# Comma-separated hostnames allowed by the app (localhost is always allowed)
# TRUSTED_HOSTS=evcharge.duckdns.org,3.108.5.112

# Simulation parameters
TIME_STEP_SECONDS=60
CHARGE_THRESHOLD=0.2
OPTIMIZATION_INTERVAL=10

# Assignment policy configuration
ASSIGNMENT_POLICY=greedy
RL_MODEL_PATH=artifacts/policy_dqn.npz
RL_NORM_STATS_PATH=artifacts/norm_stats.json
ENABLE_STALL_RESCUE=false
SIMULATE_TRAVEL_ENERGY=true
SIMULATE_TRAVEL_TIME=false
TRAVEL_SPEED_KMH=30
SIM_SEED=42